{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,32}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "intent": {
      "type": "string",
      "maxLength": 32768,
      "minLength": 1
    },
    "narration": {
      "type": "string",
      "maxLength": 32768,
      "minLength": 1
    }
  },
  "required": [
    "formatVersion",
    "id",
    "version",
    "name",
    "intent",
    "narration"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiceRealm prompt bundle import v1"
}
