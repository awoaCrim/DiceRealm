# Documentation only: ASP.NET Core does not automatically load this file.
# Set environment variables in the shell or process manager.
# No provider is called when ApiKey and Model are both absent.

# Absolute path recommended; otherwise relative to the server process working directory.
# DataPath=G:/DiceRealmData

# First admin password, used only when the data directory has no accounts yet.
# Without it a random password is generated and printed once in the server log.
# Accounts__InitialAdminPassword=
ASPNETCORE_URLS=http://127.0.0.1:5180

TextAi__Endpoint=https://api.openai.com/v1/chat/completions
TextAi__ApiKey=
TextAi__Model=
# Per intent/narration call, bounded 1..45 seconds.
TextAi__TimeoutSeconds=8

# Explicit input-preparation calls reuse TextAi endpoint/key/model, but have separate bounds.
# No built-in preparation prompt. Complete outbound JSON is limited to 128 KiB.
PreparationAi__TimeoutSeconds=120
PreparationAi__MaximumTokens=4096

# Adapter requires an OpenAI-compatible b64_json PNG response.
# Use a model/provider which supports these parameters; do not assume all image APIs do.
ImageAi__Endpoint=https://api.openai.com/v1/images/generations
ImageAi__ApiKey=
ImageAi__Model=
# Set false for providers that return base64 by default but reject response_format.
ImageAi__SendResponseFormat=true
# References stay local unless explicitly enabled; no endpoint is inferred.
ImageAi__EditsEndpoint=
ImageAi__AllowReferenceUpload=false
# Maps only: size comes from the saved map specification, never a scene prompt.
# Bounded 15..300 seconds. One explicit confirmation authorizes one attempt.
ImageAi__TimeoutSeconds=180
# Legacy ImageAi__MaxAttempts is ignored; failed/uncertain requests never auto-retry.

# Durable provider-request ceilings. 0 blocks external calls of that kind.
# Counts are global per data directory; failures/retries count, cache/offline do not.
ProviderLimits__TextDaily=200
ProviderLimits__TextCampaignDaily=100
ProviderLimits__TextTotal=2000
ProviderLimits__ImageDaily=8
ProviderLimits__ImageCampaignDaily=4
ProviderLimits__ImageTotal=40
