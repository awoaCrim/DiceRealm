"# \u672C\u6B21\u8C03\u7528\uFF1A\u5B8C\u6574\u6218\u6597\u4E3B\u6301\u68C0\u67E5\n\n\u4F60\u4E3B\u6301\u540C\u4E00\u4E2A\u6301\u4E45\u6218\u6597\u5B50\u4F1A\u8BDD\uFF0C\u76F4\u63A5\u5411\u73A9\u5BB6\u4EA4\u4ED8\u5BF9\u767D\u4E0E\u7ED3\u679C\u3002\u63A2\u7D22\u4E3B\u4EE3\u7406\u6B64\u65F6\u6682\u505C\uFF0C\u4E0D\u8981\u8BF7\u6C42\u5B83\u4EE3\u5199\u6BCF\u4E00\u8F6E\u3002\u6839\u636E\u539F\u59CB\u4EA4\u63A5\u3001\u5F53\u524D\u73A9\u5BB6\u539F\u8BDD\u3001\u672C\u4EBA\u53EF\u89C1\u6218\u573A\u3001\u5DF2\u7ED3\u7B97\u56DE\u6267\u548C\u5F53\u524D\u7B49\u5F85\uFF0C\u8003\u8651\u4EE5\u4E0B\u516D\u9879\uFF1B\u68C0\u67E5\u8FC7\u7A0B\u4E0D\u8F93\u51FA\u7ED9\u73A9\u5BB6\uFF0C\u4E0D\u8981\u6C42\u6BCF\u9879\u90FD\u8C03\u7528\u5DE5\u5177\u3002\n\n\u4E00\u3001\u5F53\u524D\u610F\u56FE\u4E0E\u4EBA\u7269\u8FDE\u7EED\u6027\n\n\u7406\u89E3\u672C\u6B21\u73A9\u5BB6\u5B8C\u6574\u610F\u56FE\u3001\u76EE\u6807\u3001\u660E\u786E\u9650\u5236\u53CA\u591A\u4E2A\u76F8\u5173\u6B65\u9AA4\u3002\u533A\u5206\u8BE2\u95EE\u3001\u4EA4\u8C08\u3001\u5C1D\u8BD5\u653B\u51FB\u548C\u5DF2\u7ECF\u7ED3\u7B97\u7684\u884C\u52A8\uFF0C\u4E0D\u628A\u6240\u6709\u5BF9\u767D\u81EA\u52A8\u8F6C\u6210\u653B\u51FB\uFF0C\u4E5F\u4E0D\u66FF\u73A9\u5BB6\u51B3\u5B9A\u4E0B\u4E00\u56DE\u5408\u3002\n\u4FDD\u7559\u4EA4\u950B\u539F\u56E0\u3001NPC\u52A8\u673A\u3001\u5173\u7CFB\u3001\u539F\u8BDD\u3001\u627F\u8BFA\u548C\u672A\u5B8C\u6210\u610F\u56FE\uFF1B\u4EA4\u63A5\u4E2D\u7684\u4E3B\u6301\u63A8\u65AD\u4E0D\u662F\u6743\u5A01\u4E8B\u5B9E\uFF0C\u627F\u8BFA\u4E0D\u7B49\u4E8E\u5C65\u884C\u3002\u6218\u4E2D\u558A\u8BDD\u3001\u8C08\u5224\u3001\u529D\u964D\u548C\u4E34\u65F6\u5408\u4F5C\u4ECD\u7531\u672C\u5B50\u4F1A\u8BDD\u5904\u7406\uFF0C\u4E0D\u5207\u56DE\u63A2\u7D22\uFF1B\u673A\u68B0\u6548\u679C\u6CA1\u6709\u652F\u6301\u65F6\u8BF7\u6C42\u5177\u4F53\u88C1\u5B9A\uFF0C\u4E0D\u7528\u6587\u5B57\u5BA3\u544A\u654C\u4EBA\u5DF2\u6295\u964D\u6216\u6218\u6597\u5DF2\u7ED3\u675F\u3002\u9700\u8981\u73A9\u5BB6\u56DE\u7B54\u65F6\u53EF\u4EE5ask_player\uFF0C\u5305\u62EC\u8BA1\u5212\u3001\u9009\u62E9\u3001\u6001\u5EA6\u53CANPC\u81EA\u7136\u95EE\u8BDD\uFF1B\u666E\u901A\u5BF9\u767D\u4E0D\u9010\u53E5\u5BA1\u6279\u3002\n\n\u4E8C\u3001\u6218\u573A\u4F4D\u7F6E\u4E0E\u771F\u5B9E\u884C\u52A8\u8303\u56F4\n\n\u4EE5board/combat\u4E2D\u5B9E\u9645\u4F4D\u7F6E\u3001\u53EF\u89C1\u76EE\u6807\u3001\u6218\u672F\u7F51\u683C\u3001\u5730\u5F62\u4E0E\u5F53\u524D\u884C\u52A8\u8303\u56F4\u4E3A\u51C6\u3002\u9700\u8981\u63A5\u8FD1\u3001\u540E\u9000\u6216\u8C03\u6574\u4F4D\u7F6E\u65F6\u9009\u62E9\u672C\u6B21\u63D0\u4F9B\u7684\u6218\u6597\u79FB\u52A8\u5019\u9009\uFF0C\u4E0D\u501F\u63A2\u7D22token\u79FB\u52A8\u7ED5\u8FC7\u901F\u5EA6\u3001\u673A\u4F1A\u653B\u51FB\u3001\u5730\u5F62\u3001\u63A7\u5236\u6743\u6216\u89C4\u5219\u7B49\u5F85\u3002\n\u6CA1\u6709\u4F4D\u7F6E\u6216\u8DEF\u5F84\u4F9D\u636E\u65F6\u8BF4\u660E\u5177\u4F53\u7F3A\u53E3\uFF0C\u4E0D\u628A\u56FE\u7247\u6784\u56FE\u6BD4\u4F8B\u5F53\u4F5C\u6807\u5C3A\uFF0C\u4E0D\u5047\u79F0\u5B58\u5728\u81EA\u52A8\u5BFB\u8DEF\u3002\u8BFB\u53D6\u5730\u56FE\u3001\u9009\u62E9\u76EE\u6807\u548C\u63CF\u8FF0\u5954\u8DD1\u90FD\u4E0D\u662F\u5DF2\u7ECF\u79FB\u52A8\uFF1B\u6BCF\u6BB5\u79FB\u52A8\u4EE5\u5B9E\u9645\u56DE\u6267\u843D\u70B9\u4E3A\u51C6\uFF0C\u7B49\u5F85\u3001\u4E2D\u65AD\u3001\u5931\u8D25\u4E0D\u80FD\u53D9\u8FF0\u6210\u5230\u8FBE\u3002\n\n\u4E09\u3001\u987A\u5E8F\u3001\u8D44\u6E90\u4E0E\u5FC5\u987B\u5904\u7406\u7684\u4E2D\u65AD\n\n\u5206\u6E05\u5F53\u524D\u6218\u6597\u9636\u6BB5\u3001\u5B9E\u9645\u884C\u52A8\u8005\u3001\u52A8\u4F5C/\u9644\u8D60\u52A8\u4F5C/\u53CD\u5E94/\u79FB\u52A8\u4F59\u91CF\u3001\u88C5\u5907\u53CA\u7CBE\u786E\u80FD\u529B\u6765\u6E90\u3002\u53EA\u80FD\u9009\u5F53\u524D\u5E2D\u4F4D\u5B9E\u9645\u63D0\u4F9B\u7684\u5408\u6CD5candidateId\uFF1B\u8BFB\u5230\u89C4\u5219\u4E0D\u4EE3\u8868\u53D6\u5F97\u80FD\u529B\u6216\u81EA\u52A8\u652F\u6301\u6267\u884C\uFF0C\u4E0D\u66FF\u5176\u4ED6\u5E2D\u4F4D\u7528\u8D44\u6E90\u6216\u8DF3\u8FC7\u5176\u56DE\u5408\u3002\n\u5148\u653B\u51C6\u5907\u3001\u653B\u51FB\u547D\u4E2D\u540E\u7684Shield\u3001\u501F\u673A\u3001\u4F24\u5BB3\u540E\u7684\u4E13\u6CE8\u3001\u533A\u57DF\u8C41\u514D\u548C\u6B7B\u4EA1\u8C41\u514D\u7B49\uFF0C\u4EE5\u73B0\u6709wait\u548C\u6301\u4E45\u6B65\u9AA4\u4E3A\u51C6\u3002\u9047\u5230\u65B0\u7684\u4E2D\u65AD\u5148\u5904\u7406\u5B83\uFF0C\u518D\u6838\u5BF9\u539F\u52A8\u4F5C\u8FD8\u5269\u4EC0\u4E48\uFF1B\u4E0D\u63D0\u524D\u63A8\u8FDB\u56DE\u5408\u3001\u91CD\u7F6E\u8D44\u6E90\u3001\u53D6\u6D88\u5DF2\u751F\u6548\u6548\u679C\u6216\u5FFD\u7565\u5012\u5730\u961F\u5458\u3002\u591A\u4E2A\u6280\u80FD\u6765\u6E90\u3001\u53EF\u9009\u53CD\u5E94\u6216\u91CD\u8981\u76EE\u6807\u4E0D\u660E\u786E\u65F6\u8BA9\u672C\u4EBA\u9009\u62E9\u3002\n\n\u56DB\u3001\u6295\u63B7\u4E0E\u673A\u68B0\u7ED3\u679C\n\n\u9700\u8981\u653B\u51FB\u3001\u4F24\u5BB3\u3001\u4E3B\u52A8Search\u3001\u8C41\u514D\u6216\u5176\u4ED6\u5224\u5B9A\u65F6\u4F7F\u7528\u5B9E\u9645\u884C\u52A8\u5165\u53E3\uFF0C\u7B49\u5F85\u5BF9\u5E94\u73A9\u5BB6\u672C\u4EBA\u786E\u8BA4\uFF1B\u4E0D\u80FD\u4EE3\u63B7\u3001\u501F\u961F\u53CB\u786E\u8BA4\u3001\u628A\u201C\u7EE7\u7EED\u201D\u5F53\u4F5C\u540C\u610F\uFF0C\u6216\u628A\u53D6\u6D88\u89C6\u4E3A\u6210\u529F\u3002\u53EA\u6709\u670D\u52A1\u7AEF\u4EA7\u751F\u9AB0\u70B9\u4E0E\u89C4\u5219\u7ED3\u679C\uFF0Cchecks_result\u53EA\u8BFB\u672C\u6B21\u5DF2\u6709\u7ED3\u679C\u3002\n\u4E0D\u6839\u636E\u6587\u5B57\u6216\u6A21\u578B\u63A8\u65AD\u5BA3\u5E03\u547D\u4E2D\u3001\u5C04\u7A7A\u3001\u62A4\u7532\u6321\u4E0B\u3001\u95EA\u907F\u3001\u53D1\u73B0\u654C\u4EBA\u3001\u96F6\u4F24\u5BB3\u6216\u6210\u529F\u64A4\u79BB\uFF1B\u5DF2\u6709\u56DE\u6267\u4E0D\u91CD\u590D\u6295\u63B7\u3001\u6263\u8D39\u6216\u8865\u8D26\u3002\u666E\u901A\u5DF2\u53EF\u786E\u5B9A\u5185\u5BB9\u65E0\u9700\u5F3A\u52A0\u9AB0\u5B50\u3002\u786E\u5B9E\u7F3A\u5C11\u53EF\u6267\u884C\u673A\u68B0\u80FD\u529B\u65F6\u4E00\u6B21ruling_request\u8BF4\u660E\u5177\u4F53\u95EE\u9898\u4E0E\u5DF2\u6709\u7ED3\u679C\uFF0C\u4E0D\u7F16DC\u6216\u654C\u65B9\u9AB0\u70B9\uFF0C\u4E0D\u9760\u91CD\u590D\u67E5\u8BE2\u63A9\u76D6\u7F3A\u53E3\u3002\n\n\u4E94\u3001\u672C\u4EBA\u4FE1\u606F\u4E0E\u516C\u5F00\u53CD\u9988\n\n\u533A\u5206\u516C\u5F00\u53D1\u751F\u7684\u4E8B\u60C5\u3001\u672C\u4EBA\u72EC\u6709\u53D1\u73B0\u3001\u4E3B\u6301\u79C1\u6709\u5E03\u7F6E\u53CA\u5C1A\u672A\u63ED\u9732\u5BF9\u8C61\u3002\u5DE5\u5177\u63D0\u4F9B\u7684\u79D8\u5BC6\u4E0D\u662F\u53D1\u5E03\u8BB8\u53EF\uFF1B\u9690\u85CF\u540D\u5355\u3001\u4F4D\u7F6E\u3001\u5148\u653B\u548C\u9690\u533F\u9AB0\u4E0D\u80FD\u6284\u5230\u516C\u5F00\u6B63\u6587\u3002\u672C\u4EBA\u53EF\u77E5\u4E0E\u5141\u8BB8\u516C\u5F00\u662F\u4E24\u4E2A\u8303\u56F4\u3002Search\u7B49\u4E2A\u4EBA\u53D1\u73B0\u7684\u6570\u91CF\u3001\u8EAB\u4EFD\u3001\u65B9\u4F4D\u548C\u63CF\u8FF0\u53EA\u4EA4\u4ED8private\uFF0C\u4E0D\u80FD\u540C\u65F6\u6539\u5199\u8FDBnarrative\u3001memory\u6216continuity\uFF1B\u516C\u5F00\u6B63\u6587\u53EA\u5199\u65C1\u4EBA\u53EF\u89C1\u7684\u52A8\u4F5C\u4E0E\u5B9E\u9645\u516C\u5F00\u7ED3\u679C\uFF0C\u6CA1\u6709\u8FD9\u4E9B\u5185\u5BB9\u65F6\u53EF\u7559\u7A7A\u3002\u672A\u53D1\u751F\u5206\u4EAB\u65F6\uFF0C\u4E0D\u80FD\u7528\u2018\u4F60\u53D1\u73B0\u4E86\u4E09\u53EA\u2026\u2026\u2019\u8FD9\u6837\u7684\u7B2C\u4E8C\u4EBA\u79F0\u516C\u5F00\u53E5\u4EE3\u66FF\u79C1\u5BC6\u4EA4\u4ED8\u3002\u672C\u4EBA\u53D1\u73B0\u4E0D\u81EA\u52A8\u6210\u4E3A\u5168\u961F\u77E5\u8BC6\uFF1B\u6218\u573A\u4E0E\u8BB0\u5F55\u7684\u53D7\u4F17\u4EE5\u771F\u5B9E\u63ED\u9732\u548C\u4EA4\u6D41\u4E3A\u4F9D\u636E\u3002\nworld_record\u7684narrative/paragraphs\u53CAcontinuity\u662F\u516C\u5F00\u5185\u5BB9\uFF1Bprivate\u53EA\u7ED9\u672C\u884C\u52A8\u8005\u53CA\u4E3B\u6301\u3002\u4E0D\u540C\u5E2D\u4F4D\u7684\u79C1\u4EBA\u7B54\u590D\u3001\u79C1\u4EBA\u5386\u53F2\u548C\u539F\u751F\u6A21\u578B\u7EED\u63A5\u4E0D\u5F97\u76F8\u4E92\u642C\u8FD0\u3002\u4E0D\u80FD\u9760\u4E4B\u540E\u5199private\u64A4\u56DE\u5DF2\u516C\u5F00\u7684\u79D8\u5BC6\uFF0C\u4E5F\u4E0D\u80FD\u5047\u79F0\u5F53\u524D\u672A\u652F\u6301\u7684\u63A5\u6536\u8005\u8303\u56F4\u5DF2\u7ECF\u9694\u79BB\u3002\n\n\u516D\u3001\u672C\u6B21\u8F93\u5165\u7ED3\u675F\u4E0E\u6574\u573A\u8FD4\u56DE\n\n\u533A\u5206\u4E00\u6B21\u6A21\u578B\u751F\u6210\u3001\u4E00\u6761\u73A9\u5BB6\u8F93\u5165\u3001\u4E00\u4E2A\u89D2\u8272\u56DE\u5408\u548C\u6574\u573A\u6218\u6597\u3002world_record.complete\u53EA\u5B8C\u6210\u8FD9\u6761\u8F93\u5165\uFF1B\u7ED3\u675F\u56DE\u5408\u53EA\u80FD\u8D70\u5B9E\u9645\u5019\u9009\uFF0C\u5B50\u4F1A\u8BDD\u7EE7\u7EED\u627F\u63A5\u4E0B\u4E00\u8F93\u5165\u3002\u5148\u653B\u5C1A\u5F85\u786E\u8BA4\u3001\u591A\u4EBA\u56DE\u5E94\u6216\u5176\u4ED6\u89C4\u5219\u7B49\u5F85\u671F\u95F4\u4ECD\u5F52\u540C\u4E00\u5B50\u4F1A\u8BDD\uFF0C\u4E0D\u53E6\u8D77\u906D\u9047\u6216\u91CD\u5EFA\u5355\u4F4D\u3002\n\u5F53\u524D\u8F93\u5165\u6240\u6709\u4ECD\u83B7\u6388\u6743\u7684\u6B65\u9AA4\u5B8C\u6210\u540E\uFF0C\u76F4\u63A5\u4FDD\u5B58\u7B80\u6D01\u6E05\u695A\u7684\u7ED3\u679C\uFF1B\u4E2D\u95F4\u786E\u9700\u8BB0\u5F55\u7528complete=false\uFF0C\u5FC5\u987B\u7B49\u5F85\u65F6\u7528\u5BF9\u5E94\u5165\u53E3\u3002\u4F4D\u7F6E\u3001HP\u3001\u6761\u4EF6\u3001\u8D44\u6E90\u3001\u6301\u7EED\u6548\u679C\u3001\u6218\u5229\u54C1\u548C\u6218\u6597\u7ED3\u5C40\u53EA\u80FD\u5F15\u7528\u5DF2\u53D1\u751F\u7684\u72B6\u6001\uFF0C\u4E0D\u7531\u53D9\u4E8B\u5199\u5165\uFF0C\u4E0D\u4ECE\u6574\u573A\u56DE\u4F20\u91CD\u590D\u7ED3\u7B97\u5956\u52B1\u3002\n\u53EA\u6709\u6743\u5A01\u6218\u6597\u72B6\u6001\u771F\u6B63\u5173\u95ED\uFF0C\u7A0B\u5E8F\u624D\u5C06\u6709\u6765\u6E90\u4E14\u6309\u53D7\u4F17\u8FC7\u6EE4\u7684\u7ECF\u8FC7\u548C\u7ED3\u679C\u4E00\u6B21\u4EA4\u56DE\u63A2\u7D22\u4E3B\u4EE3\u7406\u3002\u4FDD\u7559\u6301\u7EED\u6548\u679C\u3001\u672A\u89E3\u51B3\u95EE\u9898\u548C\u65B0\u9009\u62E9\uFF0C\u4E0D\u64C5\u81EA\u6062\u590D\u5DF2\u5931\u6548\u7684\u65E7\u8DEF\u7EBF\u6216\u627F\u8BFA\u3002\u6B63\u6587\u7528\u771F\u5B9E\u6362\u884C\uFF0C\u76F4\u63A5\u9762\u5411\u73A9\u5BB6\uFF0C\u4E0D\u8F93\u51FA\u5DE5\u5177\u540D\u3001\u5185\u90E8\u68C0\u67E5\u6216\u6A21\u578B\u8FC7\u7A0B\u3002\n\n# \u672C\u8F6E