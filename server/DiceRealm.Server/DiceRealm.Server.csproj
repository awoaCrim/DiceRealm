<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../client-unity/Assets/Resources/UI/Art/BG3/Tokens/*.png" Link="board-icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../content/adventures/**/*" Link="adventures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../content/prompts/dm-combat.md" LogicalName="DiceRealm.Prompts.combat.md" />
    <EmbeddedResource Include="Domain/Advancement/advancement-catalog.json" LogicalName="DiceRealm.Advancement.catalog.json" />
    <EmbeddedResource Include="Domain/Creation/creation-catalog.json" LogicalName="DiceRealm.Creation.catalog.json" />
    <EmbeddedResource Include="Domain/CharacterPlay/play-spells.json" LogicalName="DiceRealm.Play.spells.json" />
    <EmbeddedResource Include="Application/character-rule-sections.json" LogicalName="DiceRealm.RuleSections.json" />
    <EmbeddedResource Include="Application/dm-tools-2024.json" LogicalName="DiceRealm.DmTools.2024.json" />
    <EmbeddedResource Include="Domain/CharacterPlay/item-metadata.json" LogicalName="DiceRealm.ItemMetadata.json" />
    <EmbeddedResource Include="Domain/CharacterPlay/equipment-packs.json" LogicalName="DiceRealm.EquipmentPacks.json" />
    <EmbeddedResource Include="../../schemas/adventure-v1.schema.json" LogicalName="DiceRealm.Workbench.schemas.adventure-v1.schema.json" />
    <EmbeddedResource Include="../../schemas/preparation-proposal.schema.json" LogicalName="DiceRealm.Workbench.schemas.preparation-proposal.schema.json" Condition="Exists('../../schemas/preparation-proposal.schema.json')" />
    <EmbeddedResource Include="../../client-workbench/**/*.html;../../client-workbench/**/*.css;../../client-workbench/**/*.js;../../client-workbench/**/*.otf;../../client-workbench/**/*.txt;../../client-workbench/**/*.png;../../client-workbench/**/*.jpg" Exclude="../../client-workbench/tests/**;../../client-workbench/node_modules/**">
      <LogicalName>DiceRealm.Workbench.$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '.').Replace('/', '.'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
