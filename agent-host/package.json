{
  "name": "dicerealm-agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DiceRealm Harness generic agent host: upstream Pi SDK loop bridged to parent-controlled model/tool callbacks over JSONL stdin/stdout.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/test/*.test.js\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
